          "name": "Filter Reports by Category & Status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/reports?category=air&status=pending",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "reports"],
