    {
      "name": "02 - Telemetry Ingestion Service (:5001)",
      "item": [
        {
          "name": "List All Active Sensor Nodes",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/telemetry/nodes",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "telemetry", "nodes"]
            },
            "description": "Retrieves real-time telemetry from all VAYU wearables and reference CAAQMS stations."
          },
          "response": []
        },
        {
          "name": "Get Specific Sensor Node Details",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/telemetry/nodes/vayu-wearable-101",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "telemetry", "nodes", "vayu-wearable-101"]
            },
            "description": "Fetches single sensor metrics, 24-hr diurnal trend, and calibration confidence."
          },
          "response": []
        },
        {
          "name": "Ingest VAYU Wearable Packet",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"device_id\": \"vayu-wearable-demo-99\",\n  \"name\": \"VAYU Wearable #99 (Delivery Fleet)\",\n  \"pm25\": 168,\n  \"voc\": 480,\n  \"lat\": 28.5821,\n  \"lng\": 77.2345,\n  \"temp\": 29.2,\n  \"humidity\": 57,\n  \"confidence\": 98,\n  \"battery\": 89\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/telemetry/ingest",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "telemetry", "ingest"]
            },
            "description": "Ingests a live telemetry packet from a VAYU wearable hardware unit."
          },
          "response": []
        }
      ]
    },
    {
      "name": "03 - Hotspot Clustering Service (:5002)",
      "item": [
        {
          "name": "List Active Hotspot Clusters",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/hotspots",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "hotspots"]
            },
            "description": "Retrieves AI-detected geospatial risk clusters with radius and primary pollutant."
          },
          "response": []
        },
        {
          "name": "Run Spatial Cluster Detection Algorithm",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/hotspots/detect",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "hotspots", "detect"]
            },
            "description": "Executes spatial clustering correlating wearable sensor spikes and citizen complaints."
          },
          "response": []
        },
        {
          "name": "Update Hotspot Mitigation Status",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"mitigating\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/hotspots/cluster-h1/status",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "hotspots", "cluster-h1", "status"]
            },
            "description": "Transitions hotspot cluster status (active, mitigating, resolved)."
          },
          "response": []
        }
      ]
    },
    {
