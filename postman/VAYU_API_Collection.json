      "item": [
        {
          "name": "List All Citizen Reports",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/reports",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "reports"]
            },
            "description": "Retrieves all citizen incident reports with category, severity, and status."
